{
  "format": "seam-case",
  "version": 1,
  "name": "remind-once",
  "seed": 1842,
  "namespace": "sim-checkout-remind",
  "clock": {"start_ns": 0, "epoch": "1970-01-01T00:00:00Z"},
  "initial_state": {},
  "arrivals": [
    {"at_ns": 0, "handler": "message", "body": {"sku": "book", "amount": 500}}
  ],
  "ports": {
    "payments": {
      "mode": "script",
      "replies": [
        {"match": {"amount": 500}, "response": {"status": "pending"}, "repeat": 1}
      ]
    },
    "email": {
      "mode": "script",
      "replies": [
        {"match": {"kind": "remind"}, "response": {"status": "accepted"}, "repeat": 1}
      ]
    }
  },
  "stop": {"when": "quiescence"},
  "assertions": [
    {"op": "port_called", "port": "email", "times": 1},
    {"op": "timer_outcome", "name": "remind-once", "outcome": "fired"},
    {"op": "state_is", "path": "order.reminded", "value": true},
    {"op": "state_is", "path": "order.status", "value": "pending"},
    {"op": "stopped", "reason": "quiescence"}
  ]
